{# Jinja blocks in this file intentionally use the non-trimming `%}` form.
   Restoring the whitespace-trimming `-%}` form changes the rendered TOML
   layout and breaks the `taplo fmt --check` gate. See template/taplo.toml. #}
[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ project_description | tojson }}
requires-python = ">={{ python_version_minor }}"
{% if license == 'UNLICENSED' -%}
license = "LicenseRef-Proprietary"
{% elif license != 'Skip' -%}
license = "{{ license }}"
{% endif -%}
dependencies = []

[dependency-groups]
dev = [
  # Linting & formatting
  "ruff",
  "ty",
  "flake8",
  "flake8-pydantic",
  "flake8-async",
  "vulture",
  "deptry",
  # Testing
  "pytest",
  {% if parallel_testing %}
  "pytest-xdist",
  {% endif %}
  "pytest-cov",
  {% if use_mutmut %}
  # Mutation testing
  "mutmut",
  {% endif %}
  # Git hooks
  "prek",
  # YAML linting
  "yamllint",
  {% if use_github_actions %}
  # JSON schema validation
  "check-jsonschema",
  {% endif %}
]

[build-system]
{% if build_backend == 'uv_build' -%}
# The range follows the uv pin in mise.toml so `uv build` uses uv's built-in
# backend without downloading uv_build; scripts/bump-template-pins.sh bumps it.
requires = ["uv_build>=0.13.0,<0.14.0"]
build-backend = "uv_build"
{% else -%}
requires = ["hatchling"]
build-backend = "hatchling.build"
{% endif %}

[tool.uv]
python-preference = "only-managed"
{% if build_backend == 'uv_build' %}

[tool.uv.build-backend]
# uv_build lowercases the default module name; project_name is used unchanged.
module-name = "{{ project_name }}"
{% endif %}

[tool.ty.environment]
python-version = "{{ python_version_minor }}"

[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
show_missing = true
skip_empty = true
{% if coverage_fail_under > 0 -%}
fail_under = {{ coverage_fail_under }}
{% else -%}
# Raise once the project grows real code:
# fail_under = 80
{% endif %}
