{
  "description": "Project-local post-edit lint hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent-lint-fast.sh\"",
            "timeout": 600,
            "statusMessage": "Running fast lint checks"
          }
        ]
      }
    ]
  }
}
