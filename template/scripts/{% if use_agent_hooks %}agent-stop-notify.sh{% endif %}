#!/usr/bin/env bash
set -uo pipefail

# Keep stdout reserved for each client's hook protocol response.
client="${1:-codex}"
kernel_name="$(uname -s 2>/dev/null || true)"
if [[ "${kernel_name}" == Darwin ]] &&
  command -v afplay >/dev/null 2>&1 &&
  [[ -r /System/Library/Sounds/Glass.aiff ]]; then
  afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &
  printf '{}\n'
elif [[ "$client" == claude ]]; then
  # Claude hooks have no controlling terminal. Ask Claude Code to emit BEL.
  printf '{"terminalSequence":"\\u0007"}\n'
else
  # Codex accepts an empty Stop response; stderr reaches its terminal surface.
  printf '\a' >&2
  printf '{}\n'
fi

exit 0
