{# Jinja blocks in this file intentionally use the non-trimming `%}` form.
   Restoring the whitespace-trimming `-%}` form changes the rendered TOML
   layout and breaks the `taplo fmt --check` gate. See template/taplo.toml. #}
[tools]
# Pinned like every other tool; "latest" made task runs depend on whatever
# uv happened to resolve (lint-audit needs uv >= 0.11.19 for `uv audit`).
# aqua backend: mise's core uv plugin extracts current uv tarballs incorrectly
# (binary stays under uv-<target>/ with no bin/), silently falling back to
# any system uv.
"aqua:astral-sh/uv" = "0.12.19"
{% if "jscpd" in extra_linters -%}
node = "26.10.0"
"npm:jscpd" = "5.3.3"
{% endif -%}
"aqua:01mf02/jaq" = "3.1.1"
"aqua:sharkdp/fd" = "10.5.0"
"aqua:gitleaks/gitleaks" = "8.30.1"
"aqua:hadolint/hadolint" = "2.15.1"
"aqua:koalaman/shellcheck" = "0.11.0"
{% if "rumdl" in extra_linters -%}
"aqua:rvben/rumdl" = "0.2.78"
{% endif -%}
{% if use_github_actions -%}
"aqua:rhysd/actionlint" = "1.7.12"
{% endif -%}
"aqua:tamasfe/taplo" = "0.10.0"
{% if use_github_actions -%}
"aqua:zizmorcore/zizmor" = "1.30.1"
{% endif -%}
{% if "typos" in extra_linters -%}
"aqua:crate-ci/typos" = "1.50.3"
{% endif -%}
{% if "commentwall" in extra_linters -%}
"github:Alex-Kopylov/commentwall" = "0.2.0"
{% endif %}

# Python tools managed via uv (installed in venv)
# Accessible via `uv run <tool>` after `uv sync`
[tasks.flake8]
description = "Run flake8 async checks"
run = "uv run flake8"

[tasks.install]
description = "Install the project and its dependencies"
run = "uv sync --all-extras"

[tasks.lint]
description = "Run the full lint suite"
run = [
  { tasks = ["lint-full"] },
]

[tasks.lint-fast]
description = "Run fast, edit-safe linters"
run = [
  { tasks = [
    "lint-python-fast",
    "lint-dockerfile",
    "lint-shell",
    {% if "rumdl" in extra_linters %}
    "lint-md",
    {% endif %}
    "lint-yml",
    "lint-json",
    "lint-toml",
    {% if use_github_actions %}
    "lint-github-actions",
    {% endif %}
    {% if "typos" in extra_linters %}
    "lint-typos",
    {% endif %}
    {% if "commentwall" in extra_linters %}
    "lint-comments",
    {% endif %}
  ] },
]

[tasks.lint-full]
description = "Run fast linters plus whole-project gate checks"
run = [
  { tasks = [
    "lint-fast",
    "lint-python-deep",
    "lint-deps",
    {% if "jscpd" in extra_linters %}
    "lint-duplicates",
    {% endif %}
    "lint-secrets",
    "lint-audit",
    {% if use_github_actions %}
    "lint-gha-security",
    {% endif %}
  ] },
]

[tasks.lint-python-fast]
description = "Run fast Python checks"
run = [
  "uv run ruff check src tests",
  "uv run ruff format --check src tests",
  "uv run flake8 src",
]

[tasks.lint-python-deep]
description = "Run whole-project Python analysis"
run = [
  "uv run ty check src",
  "uv run vulture --config .vulture.toml",
]

[tasks.lint-dockerfile]
description = "Lint Dockerfiles with Hadolint"
run = "mise exec -- hadolint Dockerfile"

[tasks.lint-shell]
description = "Lint shell scripts with ShellCheck"
# fd discovers files the way ruff does: every file on disk, hidden ones
# included, minus .git and anything matched by .gitignore or .ignore (such as
# other branches' checkouts in .claude/worktrees/).
run = "mise exec -- fd --hidden --exclude .git --type file --extension sh --print0 | xargs -0 -r mise exec -- shellcheck"

{% if "rumdl" in extra_linters -%}
[tasks.lint-md]
description = "Lint Markdown files"
run = "mise exec -- rumdl check ."

{% endif -%}
[tasks.lint-yml]
description = "Lint YAML files"
run = "uv run yamllint -c .yamllint ."

[tasks.lint-json]
description = "Validate JSON syntax with jaq"
# Same file discovery as lint-shell.
run = "mise exec -- fd --hidden --exclude .git --type file --extension json --print0 | xargs -0 -r mise exec -- jaq empty"

[tasks.lint-toml]
description = "Lint and format-check TOML files with Taplo"
# Same file discovery as lint-shell; Taplo's own walk ignores .gitignore.
run = [
  "mise exec -- fd --hidden --exclude .git --type file --extension toml --print0 | xargs -0 -r mise exec -- taplo lint",
  "mise exec -- fd --hidden --exclude .git --type file --extension toml --print0 | xargs -0 -r mise exec -- taplo fmt --check",
]

{% if use_github_actions -%}
[tasks.lint-github-actions]
description = "Lint GitHub Actions workflows and the Dependabot config"
run = [
  "mise exec -- actionlint",
  "uv run check-jsonschema --builtin-schema github-workflows .github/workflows/*.yml",
  "uv run check-jsonschema --builtin-schema vendor.dependabot .github/dependabot.yml",
]

{% endif -%}
{% if "jscpd" in extra_linters -%}
[tasks.lint-duplicates]
description = "Detect duplicated code"
run = "mise exec -- jscpd --config .jscpd.json --threshold 5"

{% endif -%}
[tasks.lint-deps]
description = "Check Python dependency declarations"
run = "uv run deptry ."

[tasks.lint-secrets]
description = "Scan git history for leaked secrets"
run = "mise exec -- gitleaks git --redact --no-banner"

{% if use_github_actions -%}
[tasks.lint-gha-security]
description = "Scan GitHub Actions workflows for security issues"
run = "mise exec -- zizmor --collect=workflows .github/workflows"

{% endif -%}
[tasks.lint-audit]
description = "Scan Python dependencies for known CVEs"
run = "uv audit"

{% if "typos" in extra_linters -%}
[tasks.lint-typos]
description = "Scan for spelling mistakes"
run = "mise exec -- typos"

{% endif -%}
{% if "commentwall" in extra_linters -%}
[tasks.lint-comments]
description = "Reject walls of standalone comments in Python files"
run = "find src tests -name '*.py' -exec mise exec -- commentwall {} +"

{% endif -%}
[tasks.test]
description = "Run the pytest suite"
run = "uv run pytest tests/"

[tasks.test-cov]
description = "Run the pytest suite with a coverage report"
run = "uv run pytest tests/ --cov --cov-report=term-missing"

[tasks.verify]
description = "Build, lint, and run the coverage test suite"
run = [
  "uv build",
  { tasks = ["lint"] },
  { tasks = ["test-cov"] },
]

[tasks.format]
{% if "rumdl" in extra_linters %}
description = "Format and autofix Python, TOML, and Markdown files"
{% else %}
description = "Format and autofix Python and TOML files"
{% endif %}
run = [
  "uv run ruff format src tests",
  "uv run ruff check --fix src tests",
  "mise exec -- fd --hidden --exclude .git --type file --extension toml --print0 | xargs -0 -r mise exec -- taplo fmt",
  {% if "rumdl" in extra_linters %}
  "mise exec -- rumdl check --fix .",
  {% endif %}
]

[tasks.install-hooks]
description = "Install prek-managed pre-commit and pre-push hooks"
run = "uv run prek install --hook-type pre-commit --hook-type pre-push"
