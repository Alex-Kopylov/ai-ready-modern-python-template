{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && mise run lint-fast >&2 || exit 2",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
